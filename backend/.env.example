# Required — no code fallback. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SESSION_SECRET=replace-with-openssl-rand-hex-32-output

# Application-level AES-256-GCM journal encryption key (64 hex characters or 32-byte base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOURNAL_ENCRYPTION_KEY=replace-with-64-character-hex-aes-key
