{
  "expo": {
    "name": "Bawat Tala",
    "slug": "bawat-tala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/BT_Logo.png",
    "scheme": "bawattala",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/BT_Logo.png",
        "backgroundImage": "./assets/images/bootup_sampleIMG.png",
        "monochromeImage": "./assets/images/BT_Logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bawattala.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/BT_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bootup_sampleIMG.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8FFF8",
          "dark": {
            "backgroundColor": "#101815"
          }
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
